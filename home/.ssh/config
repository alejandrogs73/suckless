# Alias de mis máquinas. Aquí no hay claves: las da gpg-agent (SSH_AUTH_SOCK
# en .bashrc), así que este archivo puede ir en el repo sin problema.

# Servidor de casa (solo desde la red local)
Host server
	HostName 10.0.0.10
	User alejandro

# Forgejo: "git clone forgejo:alejandrogs73/suckless.git"
Host forgejo
	HostName ssh.alejandrogs.es
	User forgejo

Host ssh.alejandrogs.es
	User forgejo

Host github.com
	User git

Host *
	# Mantener vivas las conexiones inactivas (evita cortes del router)
	ServerAliveInterval 60
