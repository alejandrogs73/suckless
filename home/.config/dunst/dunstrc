# dunst: notificaciones con la paleta Everforest y Fira Code, a juego con
# dwm (borde de 2 px, verde en lo normal) y picom (esquinas de 8 px).
# Solo se ponen las opciones que cambian respecto a los valores por defecto;
# la referencia completa está en /etc/dunst/dunstrc y en man 5 dunst.

[global]
    # Arriba a la derecha, justo debajo de la barra de dwm (21 px + hueco)
    origin = top-right
    offset = (8, 29)
    width = (280, 380)
    height = (0, 200)
    notification_limit = 5
    gap_size = 6
    separator_height = 0

    font = Fira Code 10
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    ellipsize = end
    show_age_threshold = 60

    padding = 12
    horizontal_padding = 14
    text_icon_padding = 12
    frame_width = 2
    corner_radius = 8

    icon_theme = "Papirus-Dark, Adwaita"
    enable_recursive_icon_lookup = true
    icon_position = left
    min_icon_size = 32
    max_icon_size = 64
    icon_corner_radius = 6

    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 1
    progress_bar_corner_radius = 4
    progress_bar_min_width = 250
    progress_bar_max_width = 350
    highlight = "#a7c080"

    stack_duplicates = true
    sticky_history = yes
    history_length = 30

    # Colores en formato rgb:rr/gg/bb: dunst trata "#" como comentario
    dmenu = /usr/local/bin/dmenu -p dunst: -fn "Fira Code:size=11" -nb rgb:2d/35/3b -nf rgb:d3/c6/aa -sb rgb:a7/c0/80 -sf rgb:2d/35/3b
    browser = /usr/bin/xdg-open

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

# Baja prioridad: borde gris, como una ventana sin foco
[urgency_low]
    background = "#2d353b"
    foreground = "#859289"
    frame_color = "#475258"
    timeout = 5

# Normal: borde verde, como la ventana con foco
[urgency_normal]
    background = "#2d353b"
    foreground = "#d3c6aa"
    frame_color = "#a7c080"
    timeout = 8

# Crítica: borde y barra en rojo; no se cierra sola
[urgency_critical]
    background = "#2d353b"
    foreground = "#d3c6aa"
    frame_color = "#e67e80"
    highlight = "#e67e80"
    timeout = 0
