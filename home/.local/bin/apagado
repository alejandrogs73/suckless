#!/bin/sh
# Menú de apagado con dmenu (Mod+Shift+Escape en dwm). Apagar, reiniciar y
# salir de dwm piden confirmación. Suspender, apagar y reiniciar usan doas
# sin contraseña (sistema/etc/doas.conf).

confirmar() {
	[ "$(printf 'No\nSí\n' | menu -p "¿$1?")" = "Sí" ]
}

opcion=$(printf '%s\n' \
	"󰌾  Bloquear" \
	"󰤄  Suspender" \
	"󰍃  Salir de dwm" \
	"󰜉  Reiniciar" \
	"󰐥  Apagar" | menu -p "Sesión:")

case $opcion in
*Bloquear) slock ;;
*Suspender) doas -n zzz ;;
*Salir*) confirmar "Salir de dwm" && pkill -TERM -x dwm ;;
*Reiniciar) confirmar "Reiniciar" && doas -n reboot ;;
*Apagar) confirmar "Apagar" && doas -n poweroff ;;
esac
